// Barra de herramientas con pestañas (la dibuja barra_herramientas.py)
//
// Cada pestaña tiene una lista de herramientas. Cada herramienta es:
//   { "texto": "Lo que se ve en el botón", "comando": "comando_de_sublime",
//     "args": { ...opcional... }, "descripcion": "Texto de ayuda al pasar el ratón" }
// Un "-" dibuja un separador entre grupos de botones.
//
// Para saber el comando de algo: Ver → Mostrar consola, escribe
// sublime.log_commands(True), haz la acción y mira qué comando aparece.
{
	// Mostrar la barra al abrir Sublime Text y en cada ventana nueva
	"mostrar_al_iniciar": true,

	// Altura aproximada de la barra, en píxeles (también se puede arrastrar el borde)
	"altura": 110,

	"pestanas":
	[
		{
			"nombre": "Inicio",
			"herramientas":
			[
				{ "texto": "Nuevo", "comando": "new_file", "descripcion": "Archivo nuevo (Ctrl+N)" },
				{ "texto": "Abrir", "comando": "prompt_open", "descripcion": "Abrir archivo o carpeta (Ctrl+O)" },
				{ "texto": "Guardar", "comando": "save", "descripcion": "Guardar (Ctrl+S)" },
				{ "texto": "Guardar todo", "comando": "save_all" },
				{ "texto": "Cerrar", "comando": "close", "descripcion": "Cerrar pestaña (Ctrl+W)" },
				"-",
				{ "texto": "Deshacer", "comando": "undo", "descripcion": "Ctrl+Z" },
				{ "texto": "Rehacer", "comando": "redo_or_repeat", "descripcion": "Ctrl+Shift+Z" },
				"-",
				{ "texto": "Cortar", "comando": "cut" },
				{ "texto": "Copiar", "comando": "copy" },
				{ "texto": "Pegar", "comando": "paste" },
				{ "texto": "Seleccionar todo", "comando": "select_all" },
				"-",
				{ "texto": "Paleta de comandos", "comando": "show_overlay", "args": { "overlay": "command_palette" }, "descripcion": "Ctrl+Shift+P" },
			],
		},
		{
			"nombre": "Buscar",
			"herramientas":
			[
				{ "texto": "Buscar", "comando": "show_panel", "args": { "panel": "find", "reverse": false }, "descripcion": "Ctrl+F" },
				{ "texto": "Reemplazar", "comando": "show_panel", "args": { "panel": "replace", "reverse": false }, "descripcion": "Ctrl+H o Ctrl+R" },
				{ "texto": "Buscar en archivos", "comando": "show_panel", "args": { "panel": "find_in_files" }, "descripcion": "Ctrl+Shift+F" },
				{ "texto": "Siguiente", "comando": "find_next", "descripcion": "F3" },
				{ "texto": "Anterior", "comando": "find_prev", "descripcion": "Shift+F3" },
				{ "texto": "Seleccionar coincidencias", "comando": "find_all_under", "descripcion": "Selecciona todas las apariciones de la palabra o selección" },
				"-",
				{ "texto": "Ir a línea", "comando": "show_overlay", "args": { "overlay": "goto", "text": ":" }, "descripcion": "Ctrl+G" },
				{ "texto": "Ir a archivo", "comando": "show_overlay", "args": { "overlay": "goto", "show_files": true } },
				{ "texto": "Ir a símbolo", "comando": "show_overlay", "args": { "overlay": "goto", "text": "@" } },
				{ "texto": "Llave pareja", "comando": "move_to", "args": { "to": "brackets" }, "descripcion": "Ir a la llave o corchete correspondiente (Ctrl+B)" },
			],
		},
		{
			"nombre": "Líneas",
			"herramientas":
			[
				{ "texto": "Duplicar", "comando": "duplicate_line", "descripcion": "Ctrl+D" },
				{ "texto": "Eliminar", "comando": "run_macro_file", "args": { "file": "res://Packages/Default/Delete Line.sublime-macro" }, "descripcion": "Ctrl+L" },
				{ "texto": "Subir", "comando": "swap_line_up", "descripcion": "Ctrl+Shift+↑" },
				{ "texto": "Bajar", "comando": "swap_line_down", "descripcion": "Ctrl+Shift+↓" },
				{ "texto": "Unir", "comando": "join_lines", "descripcion": "Ctrl+J" },
				{ "texto": "Comentar", "comando": "toggle_comment", "args": { "block": false }, "descripcion": "Ctrl+/" },
				"-",
				{ "texto": "Ordenar", "comando": "sort_lines", "args": { "case_sensitive": false }, "descripcion": "Ordena las líneas seleccionadas (o todo el archivo)" },
				{ "texto": "Invertir orden", "comando": "permute_lines", "args": { "operation": "reverse" } },
				{ "texto": "Quitar duplicadas", "comando": "permute_lines", "args": { "operation": "unique" } },
				"-",
				{ "texto": "Saltos LF", "comando": "set_line_ending", "args": { "type": "unix" }, "descripcion": "Saltos de línea Unix" },
				{ "texto": "Saltos CRLF", "comando": "set_line_ending", "args": { "type": "windows" }, "descripcion": "Saltos de línea Windows" },
				{ "texto": "Tabs → espacios", "comando": "expand_tabs", "args": { "set_translate_tabs": true } },
				{ "texto": "Espacios → tabs", "comando": "unexpand_tabs", "args": { "set_translate_tabs": true } },
			],
		},
		{
			"nombre": "Texto",
			"herramientas":
			[
				{ "texto": "MAYÚSCULAS", "comando": "upper_case", "descripcion": "Ctrl+Shift+U" },
				{ "texto": "minúsculas", "comando": "lower_case", "descripcion": "Ctrl+U" },
				{ "texto": "Título", "comando": "title_case" },
				{ "texto": "iNVERTIR", "comando": "swap_case" },
				"-",
				{ "texto": "snake_case", "comando": "convert_to_snake" },
				{ "texto": "camelCase", "comando": "convert_to_camel" },
				{ "texto": "PascalCase", "comando": "convert_to_pascal" },
				{ "texto": "CONSTANT_CASE", "comando": "convert_to_screaming_snake" },
				{ "texto": "kebab-case", "comando": "convert_to_dash" },
				{ "texto": "dot.case", "comando": "convert_to_dot" },
				{ "texto": "separar palabras", "comando": "convert_to_separate_words" },
				"-",
				{ "texto": "Numerar 1…N", "comando": "text_pastry_range", "args": { "start": 1, "step": 1, "padding": 1 }, "descripcion": "Pon un cursor en cada línea y numera" },
				{ "texto": "UUID", "comando": "text_pastry_uuid", "descripcion": "Inserta un UUID en cada cursor" },
				{ "texto": "Fecha y hora", "comando": "insert_timestamp" },
			],
		},
		{
			"nombre": "Formato",
			"herramientas":
			[
				{ "texto": "JSON: formatear", "comando": "pretty_json" },
				{ "texto": "JSON: minificar", "comando": "un_pretty_json" },
				{ "texto": "JSON: ordenar claves", "comando": "pretty_json_and_sort" },
				{ "texto": "JSON: validar", "comando": "pretty_json_validate" },
				"-",
				{ "texto": "YAML", "comando": "prettyyaml", "descripcion": "Formatear YAML" },
				{ "texto": "XML", "comando": "indent_xml", "descripcion": "Formatear XML" },
				{ "texto": "SQL", "comando": "sql_beautifier", "descripcion": "Formatear SQL" },
				"-",
				{ "texto": "Reindentar", "comando": "reindent", "args": { "single_line": false } },
			],
		},
		{
			"nombre": "Codificar",
			"herramientas":
			[
				{ "texto": "Base64 →", "comando": "convert_to_base64", "descripcion": "Codificar en Base64" },
				{ "texto": "← Base64", "comando": "convert_from_base64", "descripcion": "Decodificar Base64 (por ejemplo, el payload de un JWT)" },
				{ "texto": "URL →", "comando": "url_encode", "descripcion": "Codificar para URL" },
				{ "texto": "← URL", "comando": "url_decode", "descripcion": "Decodificar URL" },
				{ "texto": "Hex →", "comando": "convert_to_hex" },
				{ "texto": "← Hex", "comando": "convert_from_hex" },
				{ "texto": "HTML →", "comando": "convert_chars_to_html", "descripcion": "Caracteres a entidades HTML" },
				{ "texto": "← HTML", "comando": "convert_html_to_chars", "descripcion": "Entidades HTML a caracteres" },
				"-",
				{ "texto": "Unix ↔ fecha", "comando": "convert_time_format", "descripcion": "Convierte un timestamp Unix en fecha y al revés" },
				"-",
				{ "texto": "MD5", "comando": "convert_md5" },
				{ "texto": "SHA1", "comando": "convert_sha1" },
				{ "texto": "SHA256", "comando": "convert_sha256" },
			],
		},
		{
			"nombre": "Logs y comparar",
			"herramientas":
			[
				{ "texto": "Dejar líneas con texto", "comando": "prompt_filter_to_lines", "args": { "search_type": "string", "invert_search": false } },
				{ "texto": "Dejar líneas con regex", "comando": "prompt_filter_to_lines", "args": { "search_type": "regex", "invert_search": false } },
				{ "texto": "Quitar líneas con texto", "comando": "prompt_filter_to_lines", "args": { "search_type": "string", "invert_search": true } },
				{ "texto": "Quitar líneas con regex", "comando": "prompt_filter_to_lines", "args": { "search_type": "regex", "invert_search": true } },
				"-",
				{ "texto": "Comparar con…", "comando": "sbs_compare", "descripcion": "Comparar con otra pestaña" },
				{ "texto": "Comparar con portapapeles", "comando": "sbs_compare", "args": { "compare_clipboard": true } },
				{ "texto": "Marcar selección", "comando": "sbs_mark_sel", "descripcion": "Marca la selección para compararla con otra" },
				{ "texto": "Comparar selecciones", "comando": "sbs_compare", "args": { "compare_selections": true } },
			],
		},
		{
			"nombre": "Ver",
			"herramientas":
			[
				{ "texto": "Barra lateral", "comando": "toggle_side_bar", "descripcion": "Ctrl+K, Ctrl+B" },
				{ "texto": "Minimapa", "comando": "toggle_minimap" },
				{ "texto": "Ajuste de línea", "comando": "toggle_setting", "args": { "setting": "word_wrap" } },
				{ "texto": "Pantalla completa", "comando": "toggle_full_screen" },
				{ "texto": "Sin distracciones", "comando": "toggle_distraction_free" },
				"-",
				{ "texto": "Markdown en navegador", "comando": "markdown_preview_select", "args": { "target": "browser" } },
				"-",
				{ "texto": "Consola", "comando": "show_panel", "args": { "panel": "console", "toggle": true } },
				{ "texto": "Editar esta barra", "comando": "open_file", "args": { "file": "${packages}/User/Barra de herramientas.sublime-settings" }, "descripcion": "Añadir o quitar pestañas y botones" },
			],
		},
	],
}
