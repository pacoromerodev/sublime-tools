// Barra de herramientas con pestañas (la dibuja barra_herramientas.py)
//
// Cada pestaña tiene una lista de herramientas. Cada herramienta es:
//   { "texto": "Lo que se ve en el botón", "comando": "comando_de_sublime",
//     "icono": "🔍" (opcional), "args": { ...opcional... },
//     "descripcion": "Texto de ayuda al pasar el ratón" }
// Un "-" dibuja un separador entre grupos de botones.
//
// Para saber el comando de algo: Ver → Mostrar consola, escribe
// sublime.log_commands(True), haz la acción y mira qué comando aparece.
{
	// Mostrar la barra al abrir Sublime Text y en cada ventana nueva
	"mostrar_al_iniciar": true,

	// Mostrar un emoji delante de cada pestaña y botón ("icono")
	"mostrar_iconos": true,

	// Altura aproximada de la barra, en píxeles (también se puede arrastrar el borde)
	"altura": 110,

	"pestanas":
	[
		{
			"nombre": "Inicio", "icono": "🏠",
			"herramientas":
			[
				{ "texto": "Nuevo", "icono": "📄", "comando": "new_file", "descripcion": "Archivo nuevo (Ctrl+N)" },
				{ "texto": "Abrir", "icono": "📂", "comando": "prompt_open", "descripcion": "Abrir archivo o carpeta (Ctrl+O)" },
				{ "texto": "Guardar", "icono": "💾", "comando": "save", "descripcion": "Guardar (Ctrl+S)" },
				{ "texto": "Guardar todo", "icono": "🗂️", "comando": "save_all" },
				{ "texto": "Cerrar", "icono": "✖️", "comando": "close", "descripcion": "Cerrar pestaña (Ctrl+W)" },
				"-",
				{ "texto": "Deshacer", "icono": "↩️", "comando": "undo", "descripcion": "Ctrl+Z" },
				{ "texto": "Rehacer", "icono": "↪️", "comando": "redo_or_repeat", "descripcion": "Ctrl+Shift+Z" },
				"-",
				{ "texto": "Cortar", "icono": "✂️", "comando": "cut" },
				{ "texto": "Copiar", "icono": "📋", "comando": "copy" },
				{ "texto": "Pegar", "icono": "📥", "comando": "paste" },
				{ "texto": "Seleccionar todo", "icono": "🔲", "comando": "select_all" },
				"-",
				{ "texto": "Paleta de comandos", "icono": "⌨️", "comando": "show_overlay", "args": { "overlay": "command_palette" }, "descripcion": "Ctrl+Shift+P" },
			],
		},
		{
			"nombre": "Buscar", "icono": "🔍",
			"herramientas":
			[
